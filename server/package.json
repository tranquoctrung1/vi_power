{
  "name": "vi-power-server",
  "version": "1.0.0",
  "description": "ViPower Energy Monitoring Server - CommonJS Version",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "init-db": "node init-db.js",
    "build": "pkg index.js --target node18-win-x64 --output dist/vipower-server.exe --compress GZip"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.9.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "mqtt": "^5.14.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.0",
    "nodemon": "^3.0.1"
  }
}
